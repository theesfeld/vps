[Unit]
Description=vps PTY daemon (Unix socket, never TCP)
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vpsd daemon
Restart=on-failure
RestartSec=2
# Only the daemon process. PTY shells (Grok) must survive `systemctl stop`.
KillMode=process
TimeoutStopSec=5

[Install]
WantedBy=default.target
